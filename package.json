{
  "name": "@prdal/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "test:copiloto": "npm run build && node --test test/copiloto-chat.test.js",
    "test:curriculos": "npm run build && node --test test/curriculos-pacote.test.js",
    "cleanup:test-account": "npm run build && node dist/scripts/limpar-conta-teste.js --dry-run",
    "cleanup:test-account:executar": "npm run build && node dist/scripts/limpar-conta-teste.js --executar",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "backfill:taxonomia": "nest build && node dist/scripts/backfill-taxonomia.js",
    "reprocessar:keywords": "nest build && node dist/scripts/reprocessar-keywords.js",
    "rag:reindexar": "nest build && node dist/scripts/reindexar-vetores.js",
    "tools:exportar": "nest build && node dist/scripts/exportar-tools.js ../ai-service/evals/agente/tools.json",
    "prisma:generate": "prisma generate",
    "migracao:aplicar": "prisma migrate deploy",
    "migracao:marcar-baseline": "prisma migrate resolve --applied 20261005000000_baseline",
    "postinstall": "prisma generate",
    "migrar:mongo": "nest build && node dist/scripts/migrar-mongo.js",
    "migrar:entradas": "nest build && node dist/scripts/migrar-entradas.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.2.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "mongodb": "^7.6.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
