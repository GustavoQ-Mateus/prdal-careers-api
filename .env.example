# Desenvolvimento local da API, fora do docker compose.
DATABASE_URL=postgresql://prdal:change-this-local-postgres-password@localhost:5432/prdal_careers
MONGO_URL=mongodb://prdal:change-this-local-mongo-password@localhost:27017
MONGO_DB=prdal_careers
# Fora de NODE_ENV=development a api exige JWT_SECRET com pelo menos 32 bytes.
# Em development sem JWT_SECRET a api usa um segredo aleatorio por execucao.
# Gere um com: openssl rand -base64 48
NODE_ENV=development
JWT_SECRET=
# Fora de NODE_ENV=development a api exige SERVICE_TOKEN com pelo menos 32 bytes,
# o mesmo valor configurado no ai-service e no doc-service.
SERVICE_TOKEN=
CORS_ORIGINS=http://localhost:5173
PRDAL_HTTPS=false
REFRESH_TTL_DIAS=7
REFRESH_TOLERANCIA_S=30
TRUST_PROXY=0
PORT=3000
# Prefixo publico das rotas, por exemplo /api; o /health fica fora dele e o
# API_SELF_URL nao leva o prefixo
API_PREFIXO=
API_SELF_URL=http://127.0.0.1:3000
AI_SERVICE_URL=http://localhost:8000
DOC_SERVICE_URL=http://localhost:8080
STORAGE_DIR=./storage
BATCH_CONCURRENCY=3
